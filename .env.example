# Copy this file to .env in the same folder (gitignored) and fill in real values.
# Then run: .\mvnw.cmd spring-boot:run
# You do not need $env:DATABASE_URL in PowerShell.

# Local without a database (wizard data is saved to .blink-nodb.json in this folder):
SPRING_PROFILES_ACTIVE=nodb

# Production / Render: do NOT set SPRING_PROFILES_ACTIVE=nodb. Use Postgres:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Local kit used for the download zip and S3 copy. The API also walks up from
# this folder looking for Blink-Framework/automation_sdlc if this path is wrong.
BLINK_AUTOMATION_SDLC_PATH=../../Blink-Framework/automation_sdlc

# Python Agent Runtime (FastAPI for grooming & setup apply).
# Local agent runtime: http://127.0.0.1:8787
# Deployed AWS Lambda HTTP API: https://z5i3yybrx1.execute-api.us-west-2.amazonaws.com
BLINK_AGENT_RUNTIME_URL=http://127.0.0.1:8787
BLINK_AGENT_RUNTIME_TOKEN=blink-groom-2026
BLINK_AUTOMATION_SDLC_GIT_URL=https://github.com/AtulTalentServ/automation_sdlc.git

# Canonical setup runs the framework's Python projector beside Java.
# Docker uses python3. On Windows, set this to python when python3 is unavailable.
# BLINK_CANONICAL_SETUP_PYTHON=python
# BLINK_CANONICAL_SETUP_TIMEOUT=90s

# S3 workspace storage. Never commit real keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2
# S3_BUCKET_NAME=blink-ai-dev
# S3_PUBLIC_BASE_URL=https://blink-ai-dev.s3-us-west-2.amazonaws.com/

# Comma-separated browser origins allowed to call /api
# BLINK_CORS_ORIGINS=http://localhost:5173,https://YOUR-FRONTEND.onrender.com

# AES key passphrase for GitHub/Jira tokens stored per project. Required in production.
# BLINK_INTEGRATION_SECRET_KEY=change-me-to-a-long-random-string

# Stakeholder clarification emails (POST /api/stakeholder-questions/send) and login OTP.
# Prefer Gmail OAuth (works on Render). SMTP is the fallback; when neither is set, Blink
# writes one .txt file per recipient under the outbox dir.
# Login OTPs are sent only to @talentserv.co.in (BLINK_LOGIN_ALLOWED_DOMAIN).
# BLINK_GMAIL_CLIENT_ID=
# BLINK_GMAIL_CLIENT_SECRET=
# BLINK_GMAIL_REFRESH_TOKEN=
# BLINK_GMAIL_FROM=talentservblink@gmail.com
# Optional override. Leave unset so the API host + /api/auth/gmail/oauth/callback is used.
# BLINK_GMAIL_REDIRECT_URI=
# BLINK_LOGIN_ALLOWED_DOMAIN=talentserv.co.in
# SMTP is hard-capped at 10s (Office 365 / port 465 otherwise freeze login on "Sending code…").
# Use 587 + STARTTLS, or 465 implicit TLS. Do not leave host set if the mailbox is unreachable.
# BLINK_SMTP_HOST=smtp.example.com
# BLINK_SMTP_PORT=587
# BLINK_SMTP_USERNAME=
# BLINK_SMTP_PASSWORD=
# BLINK_SMTP_FROM=blink@example.com
# BLINK_SMTP_START_TLS=true
# BLINK_SMTP_OUTBOX_DIR=.blink-outbox

# Login OTP. With a login gate, Blink shows the code on screen and skips SMTP
# (local and Render). Set BLINK_SMTP_ENABLED=true when live email is ready.
# BLINK_SMTP_ENABLED=false
# BLINK_LOGIN_GATE=talentserv-blink

# GitHub OAuth App — users sign in on Blink instead of pasting a PAT.
# Create at https://github.com/settings/developers.
# Callback is derived from the live API URL after deploy (not localhost).
# Register BOTH of these on the GitHub OAuth App:
#   http://localhost:5173/api/integrations/github/oauth/callback
#   https://YOUR-BACKEND.onrender.com/api/integrations/github/oauth/callback
# BLINK_GITHUB_CLIENT_ID=
# BLINK_GITHUB_CLIENT_SECRET=
# Optional override only. Leave unset on Render so the backend public URL is used.
# BLINK_GITHUB_REDIRECT_URI=

# Figma OAuth App — users sign in on Blink instead of pasting a PAT.
# Create at https://www.figma.com/developers/apps (private team app is enough).
# Register BOTH of these redirect URLs:
#   http://localhost:5173/api/integrations/figma/oauth/callback
#   https://YOUR-BACKEND.onrender.com/api/integrations/figma/oauth/callback
# Enable at least these scopes on the Figma app (private team app). Extra checkboxes are
# fine; Blink only requests this subset so Figma does not return Invalid scopes for app.
# Do not enable deprecated projects:read, project_metadata:read, or files:read.
# BLINK_FIGMA_CLIENT_ID=
# BLINK_FIGMA_CLIENT_SECRET=
# Optional override only. Leave unset on Render so the backend public URL is used.
# BLINK_FIGMA_REDIRECT_URI=
# BLINK_FIGMA_SCOPES=current_user:read,file_content:read,file_metadata:read
# Google Stitch API key. Used to generate a few design options from the groomed requirement.
# STITCH_API_KEY=
